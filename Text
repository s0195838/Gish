% --- ПОСТРОЕНИЕ ГРАФИКОВ ---
x = 160:5:200;

% ТЕРМ ВЫСОКИЙ
figure;
plot(x, w1, 'r-x', 'LineWidth', 1.5, 'MarkerSize', 7);
hold on;
plot(x, mu1, 'b-o', 'LineWidth', 1.5, 'MarkerSize', 7);
grid on;
xlabel('Объект');
ylabel('\mu_1');
title('Терм Высокий');
legend('Субнормальное нечеткое множество', 'Нормированное нечеткое множество', 'Location', 'best');
ylim([0 1.05]);
hold off;

