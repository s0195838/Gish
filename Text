% --- МАТРИЦА A1 (ТЕРМ ВЫСОКИЙ) ---
A1 = [1 1/2 1/3 1/4 1/5 1/6 1/7 1/8 1/9;
      2 1 1/2 1/3 1/4 1/5 1/6 1/7 1/8;
      3 2 1 1/2 1/3 1/4 1/5 1/6 1/7;
      4 3 2 1 1/2 1/3 1/4 1/5 1/6;
      5 4 3 2 1 1/2 1/3 1/4 1/5;
      6 5 3 3 2 1 1/2 1/3 1/4;
      7 5 4 4 3 2 1 1/2 1/3;
      8 7 5 5 3 3 2 1 1/2;
      9 8 7 6 5 4 3 2 1];

[V1, D1] = eig(A1);
lambda1 = diag(D1);
[max_lambda1, ind1] = max(real(lambda1));
w1 = V1(:, ind1);
w1 = real(w1);
if sum(w1) < 0
    w1 = -w1;
end
w1 = w1 / sum(w1);
mu1 = w1 / max(w1);

disp("ТЕРМ ВЫСОКИЙ");
disp("Максимальное собственное значение");
disp(max_lambda1);
disp("Собственный вектор");
disp(w1);
disp("Нормированный вектор и степени принадлежности");
disp(mu1);

% --- МАТРИЦА A2 (ТЕРМ НИЗКИЙ) ---
A2 = [1 2 3 4 5 6 7 8 9;
