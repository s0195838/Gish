      3 1 1/2 1/5 1/6 1/5 1/2 1 3;
      4 2 1 1/3 1/4 1/3 1 2 4;
      6 5 3 1 1/3 1 3 5 6;
      7 6 4 3 1 3 4 6 7;
      6 5 3 1 1/3 1 3 5 6;
      4 2 1 1/3 1/4 1/3 1 2 4;
      3 1 1/2 1/5 1/6 1/5 1/2 1 3;
      1 1/3 1/4 1/6 1/7 1/6 1/4 1/3 1];

